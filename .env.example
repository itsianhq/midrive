# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=midrive
# localhost for `bun dev` on the host; docker compose overrides the host to "postgres"
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ---- Server ----
PORT=8080
NODE_ENV=development

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API server
BETTER_AUTH_URL=http://localhost:8080
# Comma-separated web app origin(s) allowed to call the API (CORS + auth)
TRUSTED_ORIGINS=http://localhost:5173

# Any S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO, RustFS, ...)
S3_BUCKET=midrive
S3_REGION=us-east-1
# Leave empty for AWS S3. R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Only if browsers must reach S3 through a different URL than the server does
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for most self-hosted S3 servers (MinIO, RustFS, Garage)
S3_FORCE_PATH_STYLE=false

# ---- Web ----
# Public URL of the API as seen by browsers (only VITE_* vars are exposed to the web app)
VITE_API_URL=http://localhost:8080
