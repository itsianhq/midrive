# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=midrive

# ---- Server ----
PORT=8080
NODE_ENV=development

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API server
BETTER_AUTH_URL=http://localhost:8080
# Comma-separated web app origin(s) allowed to call the API (CORS + auth)
TRUSTED_ORIGINS=http://localhost:5173

# Any S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO, RustFS, ...)
S3_BUCKET=midrive
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only if browsers must reach S3 through a different URL than the server does
# S3_PUBLIC_ENDPOINT=
# true for most self-hosted S3 servers (MinIO, RustFS, Garage)
S3_FORCE_PATH_STYLE=false
# Largest single file in bytes, even for users without a quota (default and max: 5 TiB)
# MAX_UPLOAD_SIZE=

# ---- Web ----
# Public URL of the API as seen by browsers. Read when web starts, not at image build.
VITE_API_URL=http://localhost:8080
