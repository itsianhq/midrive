{
  "name": "server",
  "scripts": {
    "dev": "bun --env-file=../.env run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../.env drizzle-kit migrate",
    "db:studio": "bun --env-file=../.env drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@hono/standard-validator": "^0.4.0",
    "@scalar/hono-api-reference": "^0.12.12",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "^7.0.2"
  }
}
